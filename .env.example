# SQLite database file used by Prisma. Local file, no server required.
DATABASE_URL="file:./dev.db"

# Secret used to sign the opaque session cookie (HMAC-SHA256). Any long
# random string works for local/assessment use. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-random-64-char-hex-string-before-deploying"
