# Supabase project — required from Phase 1 onward.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key — not used until a later phase needs privileged
# (non-RLS) access, e.g. server-side cron jobs. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (VAPID) — not used until the reminders/push phase.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret for authenticating scheduled/cron requests — not used until
# the reminders phase.
CRON_SECRET=
